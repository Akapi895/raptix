# Raptix — Environment Variables
# Copied to ~/.raptix/.env by the installer. Run `raptix onboard` to reconfigure.

RAPTIX_KNOWLEDGE_CORPUS_DIR=data/knowledge

# --- LLM API Keys ---
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
MINIMAX_API_KEY=your-minimax-key-here
OPENROUTER_API_KEY=your-openrouter-key-here
MISTRAL_API_KEY=your-mistral-key-here
VOYAGE_API_KEY=your-voyage-key-here   # embeddings for skillogy retrieval

# --- Cloud gateways ---
GROQ_API_KEY=your-groq-key-here
TOGETHER_API_KEY=your-together-key-here
FIREWORKS_API_KEY=your-fireworks-key-here
COHERE_API_KEY=your-cohere-key-here
MOONSHOT_API_KEY=your-moonshot-key-here
KIMI_API_KEY=your-kimi-key-here        # api.kimi.com/coding — not the Moonshot API
ZAI_API_KEY=your-zai-key-here
DASHSCOPE_API_KEY=your-dashscope-key-here
GITHUB_TOKEN=your-github-token-here    # fine-grained PAT with the 'models' scope

# --- OpenAI-compatible gateways / aggregators ---
OPENCODE_API_KEY=your-opencode-zen-key-here
VERCEL_AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key-here
HF_TOKEN=your-hf-token-here
VENICE_API_KEY=your-venice-key-here
NANOGPT_API_KEY=your-nanogpt-key-here
SYNTHETIC_API_KEY=your-synthetic-key-here
ZENMUX_API_KEY=your-zenmux-key-here
QIANFAN_API_KEY=your-qianfan-key-here
CLOUDFLARE_AI_GATEWAY_API_KEY=your-cloudflare-ai-gateway-key-here
# CLOUDFLARE_AI_GATEWAY_API_BASE=https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/compat

# --- Cloud provider auth ---
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/service-account.json
# VERTEXAI_PROJECT=my-gcp-project-id
# VERTEXAI_LOCATION=us-central1
# AZURE_API_KEY=...
# AZURE_API_BASE=https://<resource>.openai.azure.com
# AZURE_API_VERSION=2024-08-01-preview

# --- Local / self-hosted models ---
# LM Studio:  LMSTUDIO_API_BASE=http://host.docker.internal:1234/v1
# llama.cpp:  LLAMACPP_API_BASE=http://host.docker.internal:8080/v1
# Custom gateway: CUSTOM_OPENAI_API_BASE / CUSTOM_OPENAI_API_KEY / CUSTOM_OPENAI_MODEL
#
# vLLM:
# VLLM_API_BASE=http://host.docker.internal:8000/v1
# VLLM_MODEL=qwen3-coder-30b   # must match --served-model-name exactly
# VLLM_API_KEY=
# Needs --enable-auto-tool-choice --tool-call-parser <parser>, or tool
# calls silently come back as plain text. Prefer a pure-transformer MoE
# model — vLLM disables prefix caching on Mamba/linear-attention hybrids.
#
# Ollama (pull a model first, e.g. `ollama pull qwen3-coder:30b`):
# OLLAMA_API_BASE=http://host.docker.internal:11434   # localhost if Ollama runs natively in WSL2/Linux
# OLLAMA_MODEL=qwen3-coder:30b

# --- LiteLLM Proxy ---
# Dev fallbacks below — `raptix onboard` replaces them with strong random values.
LITELLM_MASTER_KEY=sk-raptix-master
LITELLM_SALT_KEY=sk-raptix-salt-change-me

# --- PostgreSQL ---
POSTGRES_PASSWORD=raptix

# --- Neo4j ---
# Default password is public knowledge — change it unless this is a
# single-operator dev box on loopback. See docs/security/neo4j-hardening.md.
NEO4J_PASSWORD=raptix-graph

# Skillogy embeddings (default openai/text-embedding-3-small). Alt: voyage/voyage-3.
# RAPTIX_SKILLOGY_EMBED_MODEL=openai/text-embedding-3-small

# --- Model Profile ---
# eco (default) | max (every agent on HIGH tier) | test (every agent on LOW tier)
RAPTIX_MODEL_PROFILE=eco

# --- Auth Method Priority ---
# Comma-separated AuthMethods in preference order. Empty = auto-detect
# from whatever credentials are configured above.
RAPTIX_AUTH_PRIORITY=

# --- Claude Code / ChatGPT OAuth (subscription, instead of API key) ---
RAPTIX_AUTH_CLAUDE_CODE=false
RAPTIX_AUTH_CHATGPT=false
# ChatGPT: the chatgpt.com `__Secure-next-auth.session-token` cookie value.
CHATGPT_SESSION_TOKEN=

# --- Benchmark Mode ---
# 1 = CTF benchmark harness mode. Leave empty for normal engagements.
BENCHMARK_MODE=

# --- LangSmith Tracing (optional) ---
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=raptix

# --- Ports (optional) ---
# LANGGRAPH_PORT=2024
# LITELLM_PORT=4000
# POSTGRES_PORT=5432
# WEB_PORT=3000
# TERMINAL_PORT=3003
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687

# --- LangGraph dev-mode strictness ---
# Set to 1 to make a blocking sync call in a dependency fail fast instead
# of just warning (useful when debugging async issues).
# LANGGRAPH_STRICT_ASYNC=1

# --- C2 / specialist workloads ---
# Come up on demand via opscontrol (ops_start("c2-sliver") etc). Override
# to bring every profile up by hand: COMPOSE_PROFILES=c2-sliver,ad,reversing

# --- Paths ---
# RAPTIX_HOME=/home/youruser/.raptix   # no ~ — Compose can't expand it

# --- Advanced ---
# AUTO_UPDATE=false   # disable silent auto-update on `raptix start`
# RAPTIX_CHANNEL=latest
# RAPTIX_STABLE_SOAK_DAYS=7
# RAPTIX_DEBUG=true
RAPTIX_STACK_NAME=

# --- Language ---
# ISO 639-1 code for agent output language (menus, summaries, errors).
RAPTIX_LANGUAGE=en

# --- LLM client timeout (seconds) ---
# Covers long Opus generations; bump if you see mid-stream timeouts.
RAPTIX_LLM__TIMEOUT=600

# --- Reverse Engineering ---
# Ghidra 12.1 is baked into the sandbox. MCP bridge: COMPOSE_PROFILES=reversing

# --- Sandbox executor profiles (opt-in, rebuild after setting) ---
#   INSTALL_WEB_TOOLS=true    → httpx-toolkit, katana, ffuf, nuclei, testssl.sh
#   INSTALL_AD_TOOLS=true     → netexec, certipy-ad, evil-winrm
#   INSTALL_PIVOT_TOOLS=true  → ligolo-ng
#   docker compose build sandbox
# INSTALL_WEB_TOOLS=false
# INSTALL_AD_TOOLS=false
# INSTALL_PIVOT_TOOLS=false

# --- SecLists corpus (opt-in) ---
# Full danielmiessler/SecLists tree, fetched and pinned at build time.
#   docker compose build sandbox
# INSTALL_SECLISTS=false
# SECLISTS_VERSION=2024.3

# --- Campaign (evilginx2) lab bridge (opt-in) ---
# See infra/containers/campaign-bridge/README.md.
# EVILGINX_BRIDGE_TOKEN=

# --- Web project sandboxes ---
# Per-project sandbox containers; controller runs on the host
# (`raptix web sandboxes start`). Init secrets once with
# `raptix web sandboxes init-secrets --secrets-dir <dir>`.
RAPTIX_SANDBOX_SECRETS_DIR=
RAPTIX_SANDBOX_CONTROLLER_URL=
# RAPTIX_SANDBOX_CONTROLLER_TOKEN=
# RAPTIX_SANDBOX_KEY=
