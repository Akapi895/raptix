# Required. apps/api's own Postgres database (business records with no
# Raptix runtime equivalent -- Tier 1 is just Operator/Session).
DATABASE_URL=postgresql://raptix_api:change-me@127.0.0.1:5432/raptix_api

# Optional. Defaults shown.
API_PORT=8080
API_HOST=127.0.0.1
API_SESSION_DURATION_HOURS=12

# Runtime adapter (packages/raptix/raptix/interfaces/api/). Without this,
# auth still works but every Tier 2+ route (chat, projects, HITL...) fails.
LANGGRAPH_API_URL=http://127.0.0.1:2024
RAPTIX_RUNTIME_API_TOKEN_FILE=

# Vault (Tier 4: project-scoped secret storage). Without
# RAPTIX_VAULT_MASTER_KEY_FILE, Vault routes fail 503 rather than storing
# unencrypted secrets. RAPTIX_WEB_API_INTERNAL_TOKEN_FILE is the bearer token
# the runtime presents to /api/internal/vault/*; without it every internal
# vault call is refused (fail closed), independent of the session guard.
RAPTIX_VAULT_MASTER_KEY_FILE=
RAPTIX_WEB_API_INTERNAL_TOKEN_FILE=

# Sandbox file adapter (ADR-0102: project files only through the project
# sandbox). Without this, auth/Projects/Vulnerabilities/Assets still work
# but every Files route (Tier 3) fails 503.
RAPTIX_SANDBOX_KEY_FILE=

# Host sandbox controller (ADR-0086 A: each project gets its own
# `sbx-<workspaceSlug>` sandbox container at creation, before the row is
# persisted). Serve it with `raptix web sandboxes serve`; the token is the
# controller secret created by `raptix web sandboxes init-secrets`. The URL
# must be a loopback address or host.docker.internal (apps/api runs in a
# container and reaches the host controller through it). Without these,
# project creation fails 503 instead of creating a sandbox-less project.
RAPTIX_SANDBOX_CONTROLLER_URL=
RAPTIX_SANDBOX_CONTROLLER_TOKEN_FILE=

# C2 bridge (Tier 4: read-only session/listener/profile listing only --
# every mutating C2 op is stubbed 501 regardless, see c2.routes.ts). Without
# this, GET /api/c2/{sessions,listeners,profiles} fail 503.
SLIVER_BRIDGE_URL=
SLIVER_BRIDGE_TOKEN=

# Recon providers (Tier 5: POST /api/fofa/search). Each is independently
# optional -- an operator may hold a key for only one. Without a given
# provider's credentials, searching it returns 503, never an empty result.
FOFA_EMAIL=
FOFA_KEY=
ZOOMEYE_API_KEY=
QUAKE_API_KEY=
SHODAN_API_KEY=

# Single-operator seed (first boot only; a later boot with an existing
# Operator row is a no-op). Leave RAPTIX_API_OPERATOR_PASSWORD unset to get
# a generated password logged once at startup instead.
RAPTIX_API_OPERATOR_USERNAME=admin
RAPTIX_API_OPERATOR_PASSWORD=
