generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Tier 1 (ADR-0106): the only business records with no Raptix runtime
// equivalent that Tier 1 itself needs -- a single-operator credential and
// its sessions. RBAC/AI-roles proper is a Tier 6 design spike (see
// docs/design/2026-10-31-ui-app-integration-implementation-plan.md); this
// is intentionally not that schema.

model Operator {
  id           String    @id @default(cuid())
  username     String    @unique
  displayName  String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  token      String   @id
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([operatorId])
}

// Tier 2: Projects and Conversations are business records with no Raptix
// runtime equivalent -- "project" is apps/ui-app's own grouping concept, not
// the same as a Raptix EngagementContext/OPPLAN (that mapping is a Tier 3+
// decision, not made here). A Conversation's identity *is* a LangGraph
// thread -- runtimeThreadId is never optional, created in the same request
// that creates the Conversation row (see routes/conversations.routes.ts).
// Facts/fact-edges (Neo4j AKG) are Tier 5 (knowledge/graph) and deliberately
// not modeled here.

model Project {
  id            String         @id @default(cuid())
  name          String
  description   String?
  scopeJson     String?
  status        String         @default("active")
  pinned        Boolean        @default(false)
  // Tier 3: the project's sandbox identity (ADR-0086 A / ADR-0102). Generated
  // once at creation from the project id (see project-store.ts), never
  // user-editable -- the sandbox host ("sbx-<slug>") and its workspace
  // volume are keyed off this, not off `name`, which may repeat.
  workspaceSlug String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  assets        Asset[]
  vulnerabilities Vulnerability[]
  batchQueues   BatchQueue[]
  webshellConnections WebShellConnection[]
}

model Conversation {
  id              String    @id @default(cuid())
  title           String
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  roleName        String?
  agentMode       String    @default("eino_single")
  pinned          Boolean   @default(false)
  runtimeThreadId String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messages        Message[]
  vulnerabilities Vulnerability[]
  webshellConnectionId String?
  webshellConnection   WebShellConnection? @relation(fields: [webshellConnectionId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([webshellConnectionId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
}

// Tier 3 (Findings): shapes match apps/ui-app's authoritative zod schemas
// (src/api/types/{asset,vulnerability}.ts, derived from internal/database/
// {asset,vulnerability}.go) field-for-field, not the retired apps/web's
// WebAsset/FindingRecord models (different DTOs -- see ADR-0106 §0). There is
// deliberately no Asset<->Vulnerability foreign key: the authoritative
// Vulnerability schema has no asset_id field, only a free-text `target`: the
// two were never strictly linked upstream, so Asset.vulnerabilityCount is
// always 0 here rather than invented from a fuzzy text match.

model Asset {
  id                String         @id @default(cuid())
  projectId         String?
  project           Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  host              String         @default("")
  ip                String         @default("")
  port              Int            @default(0)
  domain            String         @default("")
  protocol          String         @default("")
  title             String         @default("")
  server            String         @default("")
  country           String         @default("")
  province          String         @default("")
  city              String         @default("")
  responsiblePerson String         @default("")
  department        String         @default("")
  businessSystem    String         @default("")
  environment       String         @default("")
  criticality       String         @default("")
  source            String         @default("")
  sourceQuery       String         @default("")
  status            String         @default("active")
  tags              String[]       @default([])
  firstSeenAt       DateTime       @default(now())
  lastSeenAt        DateTime       @default(now())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([projectId])
}

model Vulnerability {
  id                String        @id @default(cuid())
  conversationId    String?
  conversation      Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  projectId         String?
  project           Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  conversationTag   String?
  taskTag           String?
  taskId            String?
  taskQueueId       String?
  title             String
  description       String        @default("")
  severity          String
  status            String        @default("open")
  type              String        @default("")
  target            String        @default("")
  preconditions     String        @default("")
  reproductionSteps String        @default("")
  evidence          String        @default("")
  impact            String        @default("")
  recommendation    String        @default("")
  retestNotes       String        @default("")
  retestLog         String        @default("")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([projectId])
  @@index([conversationId])
}

// Single row (id is always "singleton") -- apps/ui-app's vulnerability-alerts
// subscription has no per-user scoping in a single-operator deployment.
model AlertSubscription {
  id          String   @id @default("singleton")
  enabled     Boolean  @default(false)
  minSeverity String   @default("high")
  updatedAt   DateTime @updatedAt
}

// Tier 5 (Knowledge & tooling). ToolGuardConfig: a single operator-authored
// regex blocklist, tested against tool-call arguments on demand
// (POST /api/tool-guard/test) -- storage + testing only, not wired into the
// live agent tool-call path (no enforcement integration exists yet; see
// tool-guard.routes.ts). AppConfig: a generic key/value JSON store reused by
// both the "ai" config section and the "tools" config section
// (config.routes.ts) -- apps/api persists what's saved here faithfully, but
// "apply" (push it live into the running LiteLLM/runtime stack) is stubbed:
// infra/config/litellm.yaml pins `store_model_in_db: false`, a deliberate
// upstream choice that there is no live admin API to defeat.

model ToolGuardConfig {
  id        String   @id @default("singleton")
  enabled   Boolean  @default(false)
  rulesJson String   @default("[]")
  updatedAt DateTime @updatedAt
}

model AppConfig {
  key       String   @id
  valueJson String
  updatedAt DateTime @updatedAt
}

// Knowledge: a RAG-style document knowledge base (internal/knowledge/types.go)
// -- no Raptix runtime equivalent (this is CyberStrikeAI's own feature, not
// the Neo4j asset/vuln knowledge graph). Items/categories/stats/retrieval-logs
// are real CRUD; embedding-backed indexing/search is deliberately not built
// (see knowledge.routes.ts) -- there is no consumer of an embedding anywhere
// else in this op list, so storing vectors nobody reads would be inert
// scaffolding, not a real feature.

model KnowledgeItem {
  id        String   @id @default(cuid())
  category  String
  title     String
  content   String   @default("")
  filePath  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model RetrievalLog {
  id             String   @id @default(cuid())
  query          String?
  conversationId String?
  messageId      String?
  riskType       String?
  retrievedItems String[] @default([])
  hits           Int?
  createdAt      DateTime @default(now())
}

// External MCP servers the agent would connect out to. The real control
// surface (RAPTIX_MCP__SERVERS, packages/raptix/raptix/execution/tools/mcp/
// client.py) is an env var parsed once at the langgraph container's
// startup -- no live reload, no per-server start/stop RPC. This table is
// the operator's *desired* config (real CRUD); start/stop stay stubbed
// (external-mcp.routes.ts) because there is nothing live to start or stop.

model ExternalMcpServer {
  name       String   @id
  configJson String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Tier 5 monitor: "executions" are derived live from each known
// Conversation's LangGraph thread state (AIMessage.tool_calls + the matching
// ToolMessage), never stored -- see services/execution-derivation.ts. There
// is no delete primitive on a thread's own message history, so a "delete"
// here hides an execution from this derived view without touching the
// underlying thread (monitor.routes.ts says so explicitly in its responses).

model HiddenExecution {
  id       String   @id
  hiddenAt DateTime @default(now())
}

// Tier 4 (Operations): "Batch task queues" maps to Tier 2's chat loop, not
// the retired apps/web's campaign/gophish/evilginx integration (that
// mapping in the plan's first draft was wrong -- confirmed from
// apps/ui-app's authoritative src/features/tasks/model.ts: a BatchTask IS
// a chat message, dispatched the same way POST /api/eino-agent dispatches
// one). "Start" runs queued messages against Tier 2's ConversationStore/
// RuntimeTransport; cron scheduling fields are stored and returned but not
// yet auto-triggered (no background scheduler loop built this pass) --
// see batch-tasks.routes.ts.

model BatchQueue {
  id                    String      @id @default(cuid())
  title                 String
  role                  String      @default("")
  hitlPolicy            String      @default("")
  scheduleMode          String      @default("manual")
  cronExpr              String      @default("")
  scheduleEnabled       Boolean     @default(true)
  nextRunAt             DateTime?
  lastScheduleTriggerAt DateTime?
  lastScheduleError     String?
  lastRunError          String?
  projectId             String?
  project               Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  concurrency           Int         @default(1)
  status                String      @default("pending")
  createdAt             DateTime    @default(now())
  startedAt             DateTime?
  completedAt           DateTime?
  currentIndex          Int         @default(0)
  tasks                 BatchTask[]

  @@index([projectId])
}

model BatchTask {
  id             String     @id @default(cuid())
  queueId        String
  queue          BatchQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  position       Int        @default(0)
  message        String
  conversationId String?
  status         String     @default("pending")
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?
  result         String?

  @@index([queueId])
}

// Tier 4: a webshell connection is metadata about an HTTP(S) webshell the
// operator already holds on an authorized target (internal/database/
// webshell.go's shape: url/password/type/method/cmdParam, not an SSH-style
// session). stateJson is the opaque UI-side PersistState blob (saved DB
// profiles, terminal tabs) the frontend round-trips -- apps/api does not
// interpret it. `exec`/`file` (actually issuing the HTTP request to `url`)
// are deliberately not built on this model -- see webshell.routes.ts.

model WebShellConnection {
  id            String         @id @default(cuid())
  projectId     String?
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  url           String
  password      String         @default("")
  type          String         @default("php")
  method        String         @default("post")
  cmdParam      String         @default("")
  remark        String         @default("")
  encoding      String         @default("auto")
  os            String         @default("auto")
  stateJson     String         @default("{}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]

  @@index([projectId])
}
