# @raptix/web-raptix-server local development defaults.
# Example values only - never place real secrets in this file.
HOST=127.0.0.1
PORT=5280
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL connection string (Prisma migrations + db client factory).
# Placeholder only - never place real credentials in this file.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/raptix_web

# API-visible workspace tree. Set explicitly for projects/planning.
WORKSPACE_PATH=D:/path/to/workspace
# Optional runtime integration. Both URL and runtime-visible root are required.
# LANGGRAPH_API_URL=http://127.0.0.1:2400
# RAPTIX_RUNTIME_WORKSPACE_ROOT=/workspace
# For a single-engagement mount, pin its slug; root then is that engagement root.
# RAPTIX_RUNTIME_WORKSPACE_SLUG=my-engagement
# RAPTIX_RUNTIME_ASSISTANTS=soundwave,decepticon,raptix,vulnresearch
# RAPTIX_RUNTIME_LANGUAGE=vi
# RAPTIX_RUNTIME_SANDBOX_URL=http://sandbox:8000
