generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Target types ─────────────────────────────────────────────────────
// Network/web attack surface targets supported by the self-hosted platform.

enum TargetType {
  web_url
  ip_range
}

enum EngagementStatus {
  draft
  planning
  running
  completed
  failed
}

// ── Application models ───────────────────────────────────────────────

model Engagement {
  id                     String           @id @default(cuid())
  name                   String
  // Operator-facing display label; falls back to `name` when unset.
  displayName            String?
  // Server-issued, globally unique workspace partition identity. Every
  // filesystem/sandbox/KG partition keys off this value — never the
  // per-owner `name`, which may repeat across owners.
  workspaceSlug          String           @unique
  targetType             TargetType
  targetValue            String
  authorizationConfirmed Boolean          @default(false)
  // Operator briefing captured at creation; the prompt Soundwave drafts scope/RoE from.
  brief                  String?
  // Explicit planning-handoff confirmation instant; null until confirmed.
  handoffConfirmedAt     DateTime?
  status                 EngagementStatus @default(draft)

  // Self-hosted single-user mode — userId is always "local".
  userId      String           @default("local")

  // LangGraph thread tracking
  threadId      String?
  workspacePath String?
  runtimeContextLockedAt DateTime?
  threads EngagementThread[]
  requests WebRequestLedger[]
  campaigns Campaign[]
  vaultSecrets VaultSecret[]
  c2Commands C2Command[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([status])
}

enum ThreadKind {
  planning
  execution
}

enum WebRequestOperation {
  create_thread
  create_run
  resume
}

enum WebRequestState {
  creating
  accepted
  uncertain
  rejected
}

model EngagementThread {
  threadId String @id
  engagementId String
  assistantId String
  kind ThreadKind
  contextHash String
  runtimeConfigHash String?
  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  requests WebRequestLedger[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([engagementId, threadId])
}

model WebRequestLedger {
  id String @id @default(cuid())
  engagementId String
  requestId String
  operation WebRequestOperation
  payloadHash String
  reservationToken String
  candidateThreadId String? @unique
  dispatchAssistantId String?
  dispatchKind ThreadKind?
  dispatchConfigHash String?
  threadId String?
  runId String?
  // Held through acceptance/uncertainty until runtime completion is verified.
  activeThreadId String? @unique
  state WebRequestState @default(creating)
  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  thread EngagementThread? @relation(fields: [engagementId, threadId], references: [engagementId, threadId], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([engagementId, requestId])
  @@unique([threadId, runId])
  @@index([state, updatedAt])
}


// -- W17 vector campaigns ---------------------------------------------
// Persisted drafts plus truthful provider jobs. The campaign provider is not
// wired in this build; generate/deploy attempts record durable jobs with an
// explicit unavailable status instead of fabricating Generated/Delivered.

model Campaign {
  id           String @id @default(cuid())
  engagementId String
  name         String
  vector       String
  status       String @default("draft")
  version      Int    @default(1)
  spec         Json
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  jobs         CampaignJob[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([engagementId, name])
  @@index([engagementId, status])
}

model CampaignJob {
  id         String @id @default(cuid())
  campaignId String
  kind       String
  status     String @default("unavailable")
  provider   String?
  error      String?
  requestId  String?
  payloadHash String?
  activeCampaignId String? @unique
  providerId String?
  providerStatus String?
  summary Json?
  campaignVersion Int?
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([campaignId, createdAt])
  @@unique([campaignId, requestId])
}


// -- W18 credentials vault --------------------------------------------
// Server-side encrypted secret storage (AES-256-GCM). The API returns only
// redacted metadata; plaintext exists solely in the dedicated reveal
// response, and every reveal is written to the engagement-scoped audit log
// (which intentionally survives secret deletion).

model VaultSecret {
  id           String @id @default(cuid())
  engagementId String
  kind         String
  label        String
  ciphertext   String
  iv           String
  authTag      String
  createdBy    String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([engagementId, kind])
}

model VaultAudit {
  id           String @id @default(cuid())
  engagementId String
  secretId     String
  action       String
  createdAt    DateTime @default(now())

  @@index([engagementId, createdAt])
}

model C2Command {
  id String @id @default(cuid())
  engagementId String
  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  sessionId String
  requestId String
  payloadHash String
  path String
  args Json
  status String @default("creating")
  exitCode Int?
  pid Int?
  stdout String @default("")
  stderr String @default("")
  stdoutTruncated Boolean @default(false)
  stderrTruncated Boolean @default(false)
  activeSessionId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([engagementId, requestId])
  @@index([engagementId, createdAt])
}

// ── Web workflow lifecycle (ADR-0069 frozen design) ──────────────────
// Migrations land incrementally per owning integration ticket (07-17).
// No relation fields to Engagement on purpose: lifecycle rows carry the
// engagement id as a plain column so runtime-owned state is never copied
// and demo data is never migrated. FKs are enforced in SQL.

// Ticket 07: trusted multi-user identity. Local single-user deployments
// keep userId="local" and never create WebUser rows.
model WebUser {
  id String @id @default(cuid())
  username String @unique
  displayName String
  // scrypt hash (N=16384,r=8,p=1) in modular PHC form; never returned by API.
  passwordHash String
  status String @default("active") // active | disabled
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebSession {
  id String @id // sha256 hex of the opaque session token; token itself never stored
  userId String
  csrfToken String
  origin String
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([userId])
}

model WebMembership {
  id String @id @default(cuid())
  engagementId String
  userId String
  role String // owner | operator | reviewer | viewer
  invitedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([engagementId, userId])
  @@index([userId])
}

// Shared consequential-action audit (tickets 07/09/10/11/12/16/17). Sensitive
// arguments and credentials are never written to detail.
model WebAuditEntry {
  id String @id @default(cuid())
  engagementId String?
  actorId String?
  action String
  targetType String?
  targetId String?
  reason String?
  detail Json?
  createdAt DateTime @default(now())
  @@index([engagementId, createdAt])
  @@index([actorId, createdAt])
}

// Ticket 08: operator-managed scope/ROE revisions with persisted review.
model ScopeRevision {
  id String @id @default(cuid())
  engagementId String
  version Int
  status String @default("pending") // pending | approved | rejected | superseded
  diff Json
  roe Json
  requestedBy String
  decidedBy String?
  decidedAt DateTime?
  decisionComment String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([engagementId, version])
  @@index([engagementId, status])
}

model WebAsset {
  id String @id @default(cuid())
  engagementId String
  identifier String
  kind String @default("host") // host | web_url | ip_range
  classification String @default("pending") // pending | in_scope | out_of_scope
  observed Boolean @default(false)
  version Int @default(1)
  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([engagementId, identifier])
  @@index([engagementId, classification])
}

// Ticket 09: persisted business plans, operation bindings, emergency stops.
model BusinessPlan {
  id String @id @default(cuid())
  engagementId String
  version Int
  status String @default("draft") // draft | proposed | approved | rejected | superseded
  body Json
  roeVersion Int?
  requestedBy String
  decidedBy String?
  decidedAt DateTime?
  decisionComment String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([engagementId, version])
  @@index([engagementId, status])
}

model OperationBinding {
  id String @id @default(cuid())
  engagementId String
  planId String
  threadId String?
  status String @default("bound") // bound | running | stopped | completed
  concurrencyVersion Int @default(1)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([engagementId, status])
}

model EmergencyStop {
  id String @id @default(cuid())
  engagementId String
  scope String // operation | project | workspace
  targetId String?
  requestedBy String
  outcome String @default("requested") // requested | acknowledged | stopped | failed | unknown | resolved
  reason String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([engagementId])
}

// W11 (ADR-0073): durable execution intent tied to an existing engagement,
// owned execution thread and approved plan. Claimed/dispatched transitions
// are worker bookkeeping; the dispatch itself always re-runs the same
// execution gate a manual start runs.
model OperationSchedule {
  id            String   @id @default(cuid())
  engagementId  String
  planId        String
  threadId      String
  requestId     String   @unique
  status        String   @default("scheduled") // scheduled | claimed | dispatched | refused | canceled | missed | uncertain
  version       Int      @default(1)
  executeAt     DateTime
  timezone      String
  reason        String
  claimedBy     String?
  claimedAt     DateTime?
  dispatchedAt  DateTime?
  runId         String?
  outcomeDetail String?
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([engagementId, status])
}

// Ticket 10: curated finding records (runtime findings stay the evidence
// producer; these are web workflow records bound to producer lineage).
model FindingRecord {
  id String @id @default(cuid())
  engagementId String
  title String
  severity String @default("medium")
  status String @default("draft") // draft | review | confirmed | remediation | retest | resolved
  body Json
  expectedVersion Int @default(1)
  sourceType String @default("authored") // authored | imported
  producerRef String?
  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([engagementId, status])
}

model EvidenceLink {
  id String @id @default(cuid())
  findingId String
  engagementId String
  kind String // artifact | digest
  artifactPath String?
  digest String?
  producer String?
  createdAt DateTime @default(now())
  @@index([findingId])
}

// Ticket 11: report lifecycle with independent version-pinned review.
model ReportRecord {
  id String @id @default(cuid())
  engagementId String
  title String
  version Int @default(1)
  status String @default("draft") // draft | in_review | approved | changes_requested | delivered
  body Json
  createdBy String
  reviewedBy String?
  reviewedAt DateTime?
  reviewComment String?
  approvedVersion Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([engagementId, status])
}

model ReportDelivery {
  id String @id @default(cuid())
  reportId String
  engagementId String
  kind String // export | delivery
  format String
  status String // completed | failed
  requestId String
  detail Json?
  createdAt DateTime @default(now())
  @@unique([reportId, requestId])
  @@index([engagementId, createdAt])
}

// Ticket 12: expiring per-user C2 session grants.
model C2Grant {
  id String @id @default(cuid())
  engagementId String
  sessionId String
  actorId String
  reviewerId String?
  status String @default("requested") // requested | approved | rejected | revoked | expired
  reason String
  commandPrefix String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([engagementId, sessionId, status])
}

// Ticket 15: durable per-actor notices.
model WebNotice {
  id String @id @default(cuid())
  engagementId String?
  actorId String
  kind String
  title String
  detail Json?
  readAt DateTime?
  dismissedAt DateTime?
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
}

// Ticket 16: versioned workspace-level settings.
model WorkspaceSetting {
  id String @id @default(cuid())
  key String @unique
  value Json
  version Int @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ticket 17: engagement closure request/decision records.
model EngagementClosure {
  id String @id @default(cuid())
  engagementId String @unique
  status String @default("requested") // requested | confirmed | rejected | closed | cancelled
  requestedBy String
  decidedBy String?
  decidedAt DateTime?
  reason String
  checklist Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ADR-0070: engagement-scoped library review proposals. A proposal references
// the canonical corpus skill by name/path and pins a snapshot revision; it
// never becomes a second executable corpus and is never read by the runtime
// skill loader or graph builder.
model LibraryReviewProposal {
  id String @id @default(cuid())
  engagementId String
  skillName String
  skillPath String
  baseRevision String
  baseBody String
  proposedBody String
  rationale String?
  status String @default("draft") // draft | proposed | approved | rejected
  version Int @default(1)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviews LibraryProposalReview[]
  // W17: versions are proposal-local; proposal id is the identity. One
  // in-review proposal per (engagementId, skillName) is enforced by the
  // partial unique index in migration 20261018000000_library_proposal_identity
  // (not expressible in the Prisma schema).
  @@index([engagementId, status])
}

// Version-pinned independent review of one proposal version.
model LibraryProposalReview {
  id String @id @default(cuid())
  proposalId String
  proposalVersion Int
  decision String // approved | rejected
  comment String?
  reviewerId String
  createdAt DateTime @default(now())
  proposal LibraryReviewProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@index([proposalId])
}
