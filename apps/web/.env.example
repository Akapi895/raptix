# Browser build-time configuration (public via import.meta.env).
# Copy to .env.local for overrides. Values with the VITE_ prefix are public.

# Data mode: "mock" (default, standalone) or "real" (requires backend bridge, Phase 4+).
VITE_DATA_MODE=mock

# Base URL for API calls in real mode.
VITE_API_BASE_URL=/api

# Vite dev-proxy target for /api (the new API server; never the legacy web 3000).
# Non-VITE variable, read by vite.config.ts via loadEnv.
RAPTIX_WEB_BACKEND_URL=http://127.0.0.1:5280

# Terminal WebSocket URL (optional; Phase 6+). Leave empty when unused.
VITE_TERMINAL_WS_URL=

# Local ports (optional overrides).
VITE_DEV_PORT=5273
VITE_PREVIEW_PORT=5274
