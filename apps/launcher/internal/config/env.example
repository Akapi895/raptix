# Raptix environment defaults
# Run raptix onboard to configure the installation.

# Provider keys
# Configure at least one credential. Placeholder keys are ignored.
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
MINIMAX_API_KEY=your-minimax-key-here
OPENROUTER_API_KEY=your-openrouter-key-here
NVIDIA_API_KEY=your-nvidia-key-here
DEEPSEEK_API_KEY=your-deepseek-key-here
XAI_API_KEY=your-xai-key-here
MISTRAL_API_KEY=your-mistral-key-here

# Cloud gateways
GROQ_API_KEY=your-groq-key-here
TOGETHER_API_KEY=your-together-key-here
FIREWORKS_API_KEY=your-fireworks-key-here
COHERE_API_KEY=your-cohere-key-here
MOONSHOT_API_KEY=your-moonshot-key-here
ZAI_API_KEY=your-zai-key-here
DASHSCOPE_API_KEY=your-dashscope-key-here

# GitHub Models requires a fine-grained token with model access.
GITHUB_TOKEN=your-github-token-here

# AWS Bedrock
# Choose a region where the required models are available.
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here
AWS_REGION=us-east-1
AWS_REGION_NAME=us-east-1

# GCP Vertex AI
# Use a service-account key and a project and region with model access.
GOOGLE_APPLICATION_CREDENTIALS=your-gcp-service-account-path-here
VERTEXAI_PROJECT=your-gcp-project-id-here
VERTEXAI_LOCATION=us-central1

# Azure OpenAI
# Set RAPTIX_MODEL_<ROLE> if deployment names differ from model IDs.
AZURE_API_KEY=your-azure-key-here
AZURE_API_BASE=your-azure-endpoint-here
AZURE_API_VERSION=2024-08-01-preview

# LM Studio
# Start the local server from the Developer tab.
LMSTUDIO_API_BASE=http://host.docker.internal:1234/v1
LMSTUDIO_MODEL=your-lmstudio-model-here
LMSTUDIO_API_KEY=lm-studio

# Custom OpenAI-compatible endpoint
CUSTOM_OPENAI_API_BASE=your-custom-openai-base-here
CUSTOM_OPENAI_API_KEY=your-custom-openai-key-here
CUSTOM_OPENAI_MODEL=your-custom-openai-model-here

# Ollama
# Set a locally pulled model and a URL reachable from LiteLLM.
# OLLAMA_API_BASE=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3-coder:30b

# --- LiteLLM Proxy ---
LITELLM_MASTER_KEY=sk-raptix-master
LITELLM_SALT_KEY=sk-raptix-salt-change-me

# --- PostgreSQL ---
POSTGRES_PASSWORD=raptix

# --- Neo4j (Attack Chain Graph DB) ---
# Used when RAPTIX_KG_BACKEND=neo4j
NEO4J_PASSWORD=raptix-graph

# --- Model Profile ---
# eco  = per-agent tier (production default)
# max  = every agent on HIGH (high-value targets)
# test = every agent on LOW (development / CI)
RAPTIX_MODEL_PROFILE=eco

# --- Auth Method Priority ---
# Comma-separated preference order. Unconfigured methods are skipped.
# Leave empty to use the runtime's default order.
#
# Valid methods: anthropic_api, anthropic_oauth, openai_api, openai_oauth,
#   google_api, minimax_api, deepseek_api, xai_api,
#   mistral_api, openrouter_api, nvidia_api,
#   bedrock_api, vertex_api, azure_api, groq_api,
#   together_api, fireworks_api, cohere_api, moonshot_api, zai_api,
#   dashscope_api, github_models_api, lmstudio_local, ollama_local,
#   ollama_cloud, custom_openai_api
RAPTIX_AUTH_PRIORITY=

# Claude Code subscription
# Enable to use host credentials or an explicit OAuth token.
RAPTIX_AUTH_CLAUDE_CODE=false

# ChatGPT subscription
# Run codex login on the host. The launcher mounts ~/.codex/auth.json into LiteLLM.
RAPTIX_AUTH_CHATGPT=false

# Leave benchmark mode unset for normal operation.
BENCHMARK_MODE=

# LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=raptix

# --- Ports (optional) ---
# LANGGRAPH_PORT=2024
# LITELLM_PORT=4000
# POSTGRES_PORT=5432
# WEB_PORT=3000

# Optional workload profiles
# Launcher startup leaves these profiles off.
#   COMPOSE_PROFILES=c2-sliver,ad,reversing

# Paths
# Use an absolute install directory for workspace mounts. Compose does not expand ~.
# RAPTIX_HOME=/home/youruser/.raptix

# Advanced
# Released builds auto-update by default. Set the value to prompt for confirmation.
#   AUTO_UPDATE=true  → apply updates automatically & unattended, then restart
#   AUTO_UPDATE=false → never check (air-gapped / version-pinned deployments)
# AUTO_UPDATE=
# RAPTIX_DEBUG=true

# Agent output language
# Use a language code such as en, vi, zh-cn or pt-br. Use wenyan for Classical Chinese.
RAPTIX_LANGUAGE=en
