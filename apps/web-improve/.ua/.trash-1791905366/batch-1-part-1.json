{
  "nodes": [
    {"id": "file:src/App.tsx", "type": "file", "name": "App.tsx", "filePath": "src/App.tsx", "summary": "Điểm vào ứng dụng React: bọc toàn bộ app trong StoreProvider và điều hướng trang dựa trên route lưu trong store, gom bảng định tuyến ROUTES từ các nhóm màn hình a–h và scenarios.", "tags": ["entry-point", "routing", "react", "app-root"], "complexity": "simple", "languageNotes": "App là default export; Router render bên trong Shell với Suspense."},
    {"id": "function:src/App.tsx:Router", "type": "file", "name": "Router", "filePath": "src/App.tsx", "lineRange": [16, 31], "summary": "Component điều hướng trung tâm: đọc route và trạng thái đăng nhập từ useStore, cho phép trang scenarios/workspaces hiển thị ngoài Shell, fallback về Login khi chưa xác thực và render trang hiện tại bên trong Shell.", "tags": ["routing", "react-component", "auth-guard"], "complexity": "simple"},
    {"id": "function:src/App.tsx:App", "type": "file", "name": "App", "filePath": "src/App.tsx", "lineRange": [33, 39], "summary": "Root component mặc định của ứng dụng, cung cấp StoreProvider bao quanh Router để toàn bộ cây component chia sẻ store demo.", "tags": ["entry-point", "root-component", "context-provider"], "complexity": "simple"},
    {"id": "file:src/main.tsx", "type": "file", "name": "main.tsx", "filePath": "src/main.tsx", "summary": "Entrypoint Vite/React: mount App vào phần tử #root với React.StrictMode và nạp stylesheet toàn cục từ index.css.", "tags": ["entry-point", "bootstrap", "react-dom"], "complexity": "simple", "languageNotes": "Không export gì; file khởi động duy nhất của bundle."},
    {"id": "file:src/screens/ai-copilot.tsx", "type": "file", "name": "ai-copilot.tsx", "filePath": "src/screens/ai-copilot.tsx", "summary": "Drawer 'Ask AI' nổi toàn màn hình theo ngữ cảnh trang hiện tại: gợi ý câu hỏi theo loại đối tượng, tự tạo conversation khi thiếu và chặn các hành động đề xuất theo vai trò, quyền và chế độ AI của hội thoại.", "tags": ["ai-copilot", "drawer", "react-component", "accessibility"], "complexity": "moderate"},
    {"id": "function:src/screens/ai-copilot.tsx:CopilotDrawer", "type": "file", "name": "CopilotDrawer", "filePath": "src/screens/ai-copilot.tsx", "lineRange": [23, 113], "summary": "Panel copilot có focus-trap và phím Escape/Tab, tự động tạo conversation qua A.createConversation khi mở lần đầu, render Thread/Composer dùng chung từ g-common cùng các nút hành động (Explain/Summarize/Propose/Create Finding) và modal xác nhận trước khi thay đổi trạng thái.", "tags": ["drawer", "focus-management", "ai-chat", "react-component"], "complexity": "moderate"},
    {"id": "file:src/screens/demo-guide.tsx", "type": "file", "name": "demo-guide.tsx", "filePath": "src/screens/demo-guide.tsx", "summary": "Hệ thống walkthrough demo: định nghĩa bộ guide E2E-01→11 và WF-A→G với từng bước điều hướng kèm persona/dự án, cùng panel hướng dẫn nổi ở góc dưới trái tự động chuyển bước khi người dùng tự mở đúng màn hình kế tiếp.", "tags": ["demo-walkthrough", "guides", "onboarding", "external-store"], "complexity": "complex", "languageNotes": "Export GUIDES (dữ liệu), stopGuide, jump, launchGuide, DemoGuide; trạng thái panel dùng useSyncExternalStore trên module-level state, không dùng localStorage."},
    {"id": "function:src/screens/demo-guide.tsx:stopGuide", "type": "file", "name": "stopGuide", "filePath": "src/screens/demo-guide.tsx", "lineRange": [255, 255], "summary": "Xoá trạng thái walkthrough (id về null, bước về 0) để kết thúc hướng dẫn demo đang chạy.", "tags": ["demo-walkthrough", "state-reset", "helper"], "complexity": "simple"},
    {"id": "function:src/screens/demo-guide.tsx:jump", "type": "file", "name": "jump", "filePath": "src/screens/demo-guide.tsx", "lineRange": [258, 264], "summary": "Chuyển persona và dự án theo yêu cầu của bước hướng dẫn (tự đăng nhập nếu cần) rồi điều hướng đến đích Dest sau một delay ngắn để store kịp cập nhật.", "tags": ["navigation", "persona-switch", "demo-walkthrough"], "complexity": "simple"},
    {"id": "function:src/screens/demo-guide.tsx:launchGuide", "type": "file", "name": "launchGuide", "filePath": "src/screens/demo-guide.tsx", "lineRange": [267, 274], "summary": "Khởi động một guide theo id: đặt bước bắt đầu, jump tới màn hình đầu tiên với persona/dự án tương ứng và hiện toast hướng dẫn người dùng theo dõi panel walkthrough.", "tags": ["demo-walkthrough", "launcher", "navigation"], "complexity": "simple"},
    {"id": "function:src/screens/demo-guide.tsx:DemoGuide", "type": "file", "name": "DemoGuide", "filePath": "src/screens/demo-guide.tsx", "lineRange": [278, 339], "summary": "Panel walkthrough nổi ở góc dưới trái: hiển thị bước hiện tại với lý do và hành động cần làm, nút 'Simulated action' chạy mutate dữ liệu demo, tự tăng bước khi route khớp màn hình kế tiếp, cảnh báo lệch persona và có chế độ thu gọn.", "tags": ["demo-walkthrough", "react-component", "auto-advance"], "complexity": "moderate"}
  ],
