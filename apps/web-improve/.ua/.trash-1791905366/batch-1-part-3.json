    {"id": "function:src/store.tsx:allocation", "type": "file", "name": "allocation", "filePath": "src/store.tsx", "lineRange": [326, 335], "summary": "Tính phân bổ agent cho dự án: agent của dự án cộng pool trống, đếm connected/busy/available/disconnected — connected không đồng nghĩa available.", "tags": ["agents", "allocation", "metrics"], "complexity": "simple"},
