    {"id": "function:src/shell.tsx:Notices", "type": "file", "name": "Notices", "filePath": "src/shell.tsx", "lineRange": [412, 456], "summary": "Panel thông báo: danh sách notice nhóm theo loại, đánh dấu đã đọc, mute và liên kết điều hướng tới màn hình liên quan của từng notice.", "tags": ["notifications", "panel", "navigation"], "complexity": "moderate"},
