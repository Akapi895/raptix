{
  "nodes": [
    {"id": "file:src/screens/scenarios.tsx", "type": "file", "name": "scenarios.tsx", "filePath": "src/screens/scenarios.tsx", "summary": "Trang home của prototype hiển thị ngoài app (không cần login): launcher cho các demo E2E-01→11 và workflow AI WF-A→G, kèm bốn tab tài liệu hoá — interaction matrix, role matrix, state coverage và acceptance checklist với trạng thái kiểm thử được ghi bảo thủ.", "tags": ["demo-launcher", "documentation", "prototype", "routing"], "complexity": "complex", "languageNotes": "Export routes gồm 'scenarios' và 'workspaces'; dùng jump/launchGuide/GUIDES từ demo-guide để đặt persona + dự án trước khi điều hướng vào app."},
    {"id": "function:src/screens/scenarios.tsx:ScenariosPage", "type": "file", "name": "ScenariosPage", "filePath": "src/screens/scenarios.tsx", "lineRange": [133, 321], "summary": "Trang chính của prototype: chọn persona từ USERS, reset demo state qua confirm dialog, khởi chạy guide bằng launchGuide và hiển thị các bảng MATRIX (interaction), RMAT (role), COVER (state coverage) và ACCEPT (acceptance criteria) kèm liên kết mở thẳng màn hình thật.", "tags": ["demo-launcher", "matrix", "react-component"], "complexity": "moderate"},
    {"id": "function:src/screens/scenarios.tsx:WorkspacesPage", "type": "file", "name": "WorkspacesPage", "filePath": "src/screens/scenarios.tsx", "lineRange": [323, 360], "summary": "Trang chọn workspace/tổ chức: danh sách ORGS tìm kiếm được với role, số dự án, múi giờ và badge; nút mở workspace gọi jump để đăng nhập và vào app.", "tags": ["workspace-switcher", "list-view", "search"], "complexity": "simple"},
    {"id": "file:src/shell.tsx", "type": "file", "name": "shell.tsx", "filePath": "src/shell.tsx", "summary": "Khung ứng dụng (app shell): sidebar điều hướng 12 mục có badge, topbar với global search/notifications/profile, project switcher, context ribbon, banner và dialog emergency-stop, modal toàn cục (confirm/unsaved changes), toast cùng tích hợp CopilotDrawer và DemoGuide.", "tags": ["app-shell", "navigation", "layout", "react"], "complexity": "complex", "languageNotes": "Export NAV, Shell và type Route; Tabs/Segmented/Activity/ShieldAlert ở cuối file chỉ là re-export từ ui.tsx, không phải định nghĩa mới."},
    {"id": "function:src/shell.tsx:Shell", "type": "file", "name": "Shell", "filePath": "src/shell.tsx", "lineRange": [827, 860], "summary": "Component layout gốc của app: ghép Sidebar, Topbar, ContextRibbon, StopBanner, khu main (chế độ wide cho console/AI workspace, banner read-only cho dự án đóng) cùng các lớp phủ toàn cục CopilotDrawer, GlobalModals, Toasts và DemoGuide.", "tags": ["app-shell", "layout", "react-component"], "complexity": "moderate"},
    {"id": "function:src/shell.tsx:useBadges", "type": "file", "name": "useBadges", "filePath": "src/shell.tsx", "lineRange": [58, 68], "summary": "Custom hook tính badge số lượng pending cho từng mục điều hướng: approvals chờ duyệt (theo role), plan in_review/proposed, session requests và operation đang chạy.", "tags": ["custom-hook", "badges", "navigation"], "complexity": "simple"},
    {"id": "function:src/shell.tsx:Sidebar", "type": "file", "name": "Sidebar", "filePath": "src/shell.tsx", "lineRange": [70, 136], "summary": "Sidebar điều hướng chính: render NAV theo nhóm, hỗ trợ thu gọn/chế độ mobile, điều hướng bàn phím bằng phím mũi tên/Home/End và hiển thị badge pending lấy từ useBadges.", "tags": ["navigation", "sidebar", "keyboard-nav"], "complexity": "moderate"},
    {"id": "function:src/shell.tsx:ProjectSwitcher", "type": "file", "name": "ProjectSwitcher", "filePath": "src/shell.tsx", "lineRange": [139, 219], "summary": "Modal đổi dự án: danh sách dự án truy cập được với trạng thái, cảnh báo unsaved changes khi rời trang, phân biệt read-only và hiệu ứng loading khi chuyển ngữ cảnh.", "tags": ["project-switcher", "modal", "context"], "complexity": "moderate"},
    {"id": "function:src/shell.tsx:GlobalSearch", "type": "file", "name": "GlobalSearch", "filePath": "src/shell.tsx", "lineRange": [225, 318], "summary": "Ô tìm kiếm toàn cục quét assets/agents/findings/reports/projects với kết quả phân nhóm, chỉ trả dữ liệu trong phạm vi dự án được phép, hỗ trợ phím tắt và điều hướng giữ ngữ cảnh.", "tags": ["global-search", "navigation", "scoped"], "complexity": "moderate"},
