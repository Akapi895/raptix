    {"id": "function:src/shell.tsx:LoadingState", "type": "file", "name": "LoadingState", "filePath": "src/shell.tsx", "lineRange": [861, 870], "summary": "Skeleton trạng thái loading khi đang chuyển ngữ cảnh dự án, với aria-busy phục vụ accessibility.", "tags": ["loading", "skeleton", "a11y"], "complexity": "simple"},
    {"id": "file:src/store.tsx", "type": "file", "name": "store.tsx", "filePath": "src/store.tsx", "summary": "Store trung tâm của prototype: React context cung cấp DB demo (seed từ data.ts), điều hướng hash-based, persona/role, phân quyền, toasts/confirm, cùng hàng chục action mô phỏng toàn bộ vòng đời dự án, plan, operation, session, finding, report và hội thoại AI.", "tags": ["state-management", "context", "simulation", "routing"], "complexity": "complex", "languageNotes": "Export utility thời gian (hhmm, hhmm12, stamp, today), predicate chính sách (canAccessProject, sessionPerm, computePreflight, preflightPass, closureChecklist, eligibility, readiness, completion, allocation, groupSummary) và hook useStore/useDirty; PlanStatus/ToolEvent chỉ là re-export type từ data.ts."},
    {"id": "function:src/store.tsx:hhmm", "type": "file", "name": "hhmm", "filePath": "src/store.tsx", "lineRange": [8, 11], "summary": "Trả giờ HH:MM theo đồng hồ mô phỏng UTC+7 tăng dần từ thời điểm tải trang.", "tags": ["time-utility", "simulation", "helper"], "complexity": "simple"},
    {"id": "function:src/store.tsx:hhmm12", "type": "file", "name": "hhmm12", "filePath": "src/store.tsx", "lineRange": [12, 15], "summary": "Định dạng giờ 12 tiếng kèm AM/PM từ đồng hồ mô phỏng, dùng trong stamp.", "tags": ["time-utility", "simulation", "helper"], "complexity": "simple"},
    {"id": "function:src/store.tsx:stamp", "type": "file", "name": "stamp", "filePath": "src/store.tsx", "lineRange": [16, 16], "summary": "Tạo chuỗi timestamp đầy đủ 'Oct 13, 2026, h:mm AM/PM (UTC+7)' dùng cho audit log và transcript.", "tags": ["time-utility", "audit", "helper"], "complexity": "simple"},
    {"id": "function:src/store.tsx:today", "type": "file", "name": "today", "filePath": "src/store.tsx", "lineRange": [17, 17], "summary": "Trả chuỗi ngày cố định của demo ('Oct 13, 2026').", "tags": ["time-utility", "simulation", "helper"], "complexity": "simple"},
    {"id": "function:src/store.tsx:canAccessProject", "type": "file", "name": "canAccessProject", "filePath": "src/store.tsx", "lineRange": [35, 40], "summary": "Kiểm tra quyền truy cập dự án: admin/manager/reviewer truy cập mọi project, các role khác phải là thành viên của dự án.", "tags": ["rbac", "access-control", "helper"], "complexity": "simple"},
    {"id": "function:src/store.tsx:sessionPerm", "type": "file", "name": "sessionPerm", "filePath": "src/store.tsx", "lineRange": [42, 46], "summary": "Xác định quyền trên session: none nếu là viewer hoặc không truy cập được dự án, đọc grant cá nhân nếu có, mặc định read-only.", "tags": ["rbac", "sessions", "grants"], "complexity": "simple"},
    {"id": "function:src/store.tsx:nextProjectId", "type": "file", "name": "nextProjectId", "filePath": "src/store.tsx", "lineRange": [48, 51], "summary": "Sinh mã dự án kế tiếp theo pattern RT-2026-XXX dựa trên số thứ tự lớn nhất hiện có trong DB.", "tags": ["id-generation", "helper", "projects"], "complexity": "simple"},
    {"id": "function:src/store.tsx:computePreflight", "type": "file", "name": "computePreflight", "filePath": "src/store.tsx", "lineRange": [56, 100], "summary": "Chạy 8 kiểm tra preflight cho operation: ROE đã duyệt, cửa sổ thời gian, asset in-scope/approved, agent online, approval của tool, kèm trạng thái pass/fail/review và gợi ý route khắc phục cho từng mục.", "tags": ["preflight", "policy-checks", "validation"], "complexity": "moderate"},
    {"id": "function:src/store.tsx:preflightPass", "type": "file", "name": "preflightPass", "filePath": "src/store.tsx", "lineRange": [101, 101], "summary": "Predicate trả true khi mọi check preflight đều đạt trạng thái pass.", "tags": ["preflight", "predicate", "helper"], "complexity": "simple"},
    {"id": "function:src/store.tsx:closureChecklist", "type": "file", "name": "closureChecklist", "filePath": "src/store.tsx", "lineRange": [104, 120], "summary": "Tổng hợp điều kiện đóng dự án: không operation đang chạy, không finding ở draft/review, không session còn grant hoạt động và báo cáo đã approved/exported.", "tags": ["closure", "checklist", "workflow"], "complexity": "simple"},
