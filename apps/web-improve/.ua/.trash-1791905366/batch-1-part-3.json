    {"id": "function:src/shell.tsx:EligBadge", "type": "file", "name": "EligBadge", "filePath": "src/shell.tsx", "lineRange": [623, 649], "summary": "Badge execution eligibility của dự án: tính eligibility từ store, hiển thị các lý do chưa đủ điều kiện trong popover và điều hướng tới màn hình khắc phục.", "tags": ["eligibility", "badge", "rbac"], "complexity": "simple"},
