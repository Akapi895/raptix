    {"id": "function:src/shell.tsx:EmergencyStop", "type": "file", "name": "EmergencyStop", "filePath": "src/shell.tsx", "lineRange": [553, 593], "summary": "Dialog dừng khẩn cấp: chọn phạm vi (operation/dự án/toàn bộ), bắt buộc nhập lý do và xác nhận tác động, liệt kê operation/session bị ảnh hưởng rồi gọi A.emergencyStop.", "tags": ["emergency-stop", "safety", "modal"], "complexity": "moderate"},
