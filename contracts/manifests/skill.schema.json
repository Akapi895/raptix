{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raptix.local/contracts/manifests/skill.schema.json",
  "title": "Skill frontmatter",
  "description": "Optional YAML frontmatter in a SKILL.md. Files without frontmatter use their directory name as identity and remain valid skills.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "type": "string", "const": "manifest/v1" },
    "kind": { "type": "string", "const": "skill" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "license": { "type": "string" },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
