{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raptix.local/contracts/manifests/tool.schema.json",
  "title": "Tool manifest",
  "description": "A tool manifest describes a capability: input/output schema, executor (builtin|command|mcp), runtime requirements and source ref. Loading a manifest does not load code or run shell; implementations are registered explicitly through application wiring. A tool existing in the catalog never grants permission to run it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "name", "executor"],
  "properties": {
    "apiVersion": { "type": "string", "const": "manifest/v1" },
    "kind": { "type": "string", "const": "tool" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "license": { "type": "string" },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["builtin", "command", "mcp"] },
        "command": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "runtime": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "container": { "type": "boolean" },
        "network": { "type": "boolean" },
        "resources": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "input": { "$ref": "#/$defs/schema" },
    "output": { "$ref": "#/$defs/schema" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": { "type": "string" },
        "path": { "type": "string" },
        "commit": { "type": "string" }
      }
    }
  },
  "$defs": {
    "schema": {
      "description": "JSON Schema describing tool input or output",
      "type": ["object", "boolean"]
    }
  }
}
