{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raptix.local/contracts/manifests/profile.schema.json",
  "title": "Agent profile manifest",
  "description": "An agent profile describes a role: prompt refs, requested skills/tools/resources and model preference. A profile describes a role, not a running instance; profile or persona never grants execution rights.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "name"],
  "properties": {
    "apiVersion": { "type": "string", "const": "manifest/v1" },
    "kind": { "type": "string", "const": "profile" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "promptRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "requested": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "resources": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "model": { "type": "string" },
    "license": { "type": "string" }
  }
}
