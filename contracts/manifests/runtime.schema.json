{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raptix.local/contracts/manifests/runtime.schema.json",
  "title": "Runtime profile manifest",
  "description": "A runtime profile declares the environment and inventory available to a capability that needs a sandbox.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "name"],
  "properties": {
    "apiVersion": { "type": "string", "const": "manifest/v1" },
    "kind": { "type": "string", "const": "runtime" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "license": { "type": "string" },
    "image": { "type": "string" },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
