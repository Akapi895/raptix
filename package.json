{
  "name": "raptix",
  "private": true,
  "workspaces": [
    "apps/cli",
    "apps/desktop",
    "apps/ui-app",
    "apps/api",
    "apps/shared/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@raptix/ui-app",
    "dev:api": "npm run dev --workspace=@raptix/api",
    "build": "npm run build --workspace=@raptix/ui-app",
    "build:api": "npm run build --workspace=@raptix/api",
    "start": "npm run start --workspace=@raptix/api",
    "start:web": "npm run preview --workspace=@raptix/ui-app",
    "desktop": "npm run start --workspace=@raptix/desktop",
    "desktop:test": "npm test --workspace=@raptix/desktop",
    "prisma:generate": "npm run prisma:generate --workspace=@raptix/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@raptix/api"
  },
  "dependencies": {
    "@prisma/client": "^7.7.0"
  },
  "devDependencies": {
    "prisma": "^7.7.0"
  },
  "overrides": {
    "fast-uri": "^3.1.2",
    "langsmith": "0.6.3",
    "@langchain/core": {
      "langsmith": "0.6.3"
    }
  },
  "allowScripts": {
    "sharp@0.35.4": true
  }
}
