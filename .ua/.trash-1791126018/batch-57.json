      "filePath": "docker-compose.yml",
      "summary": "Neo4j 5.26.28 làm attack-chain graph (KG): dual-homed trên sandbox-net + raptix-net, APOC allowlist-only (không file-I/O), strict config validation, HTTP chỉ localhost và mem_limit 2g chống swap-thrash khi quét graph lớn.",
      "tags": ["neo4j", "knowledge-graph", "hardening"],
      "complexity": "moderate"
    },
    {
